// Resource script for the application icon.
//
// Compiled by build.rs with the Windows SDK's rc.exe; paths are relative to
// this file. The icon itself is generated by `cargo run --example make_icon`.

#include <windows.h>

// IDI_APPLICATION (32512) is the conventional slot for an executable's main
// icon, so Explorer and the taskbar pick it up without further configuration.
IDI_APPLICATION ICON "icon.ico"
